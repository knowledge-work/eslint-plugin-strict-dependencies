{
  "name": "eslint-plugin-strict-dependencies",
  "description": "ESlint plugin to define custom module dependency rules.",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/knowledge-work/eslint-plugin-strict-dependencies.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "lint",
    "rule",
    "check",
    "import",
    "module",
    "directory",
    "strict",
    "dependencies"
  ],
  "license": "MIT",
  "main": "index.js",
  "files": [
    "strict-dependencies",
    "index.js"
  ],
  "engines": {
    "node": "^22.17.0 || >=24.8.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "vitest": "5.1.0"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "preversion": "echo \"Run check for version $npm_package_version\" && pnpm test",
    "release": "git push --follow-tags origin main && pnpm publish --access public --provenance"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
