{
  "name": "eslint-plugin-strict-dependencies",
  "description": "ESlint plugin to define custom module dependency rules.",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/knowledge-work/eslint-plugin-strict-dependencies.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "lint",
    "rule",
    "check",
    "import",
    "module",
    "directory",
    "strict",
    "dependencies"
  ],
  "license": "MIT",
  "main": "index.js",
  "files": [
    "strict-dependencies",
    "index.js"
  ],
  "engines": {
    "node": "^22.17.0 || >=24.8.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "vitest": "5.1.0"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "preversion": "echo \"Run check for version $npm_package_version\" && pnpm test",
    "release": "git push --follow-tags origin main && pnpm publish --access public --provenance"
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
