{
  "name": "eslint-plugin-strict-dependencies",
  "description": "ESlint plugin to define custom module dependency rules.",
  "version": "1.3.36",
  "repository": {
    "type": "git",
    "url": "https://github.com/knowledge-work/eslint-plugin-strict-dependencies.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "lint",
    "rule",
    "check",
    "import",
    "module",
    "directory",
    "strict",
    "dependencies"
  ],
  "license": "MIT",
  "main": "index.js",
  "files": [
    "strict-dependencies",
    "index.js"
  ],
  "dependencies": {
    "is-glob": "4.0.3",
    "micromatch": "4.0.8",
    "normalize-path": "3.0.0",
    "require-strip-json-comments": "2.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "vitest": "5.1.0"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "preversion": "echo \"Run check for version $npm_package_version\" && pnpm test",
    "release": "pnpm publish --access public --provenance && git push --follow-tags origin main"
  },
  "packageManager": "pnpm@12.20.0+sha512.6ccc74997ccef4e67999788e18dbfbfa583e2a849668668db4707b6a8306662f47156e650232a985bd3ec24cf9364c1aa154d37e51ed7aac62c1cd1e3afc80c3",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
